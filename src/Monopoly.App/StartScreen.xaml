<UserControl x:Class="Monopoly.App.StartScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F4F1EA">
        <Border Width="620" Padding="32" Margin="16" Background="White" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Монополия" FontSize="40" FontWeight="Bold" Margin="0,0,0,24"/>

                <TextBlock Text="Ваше имя"/>
                <TextBox Name="NameBox" MaxLength="20" Padding="4" Margin="0,4,0,16"/>

                <Button Name="CreateButton" Content="Создать игру" Height="44" Click="Create_Click"/>
                <TextBlock Text="Вы станете хостом, друзья подключатся к вам." Foreground="Gray" FontSize="14" Margin="0,4,0,0"/>

                <Separator Margin="0,20"/>

                <TextBlock Text="Подключиться к игре"/>
                <DockPanel Margin="0,4,0,0">
                    <Button Name="JoinButton" Content="Подключиться" DockPanel.Dock="Right" Width="170" Margin="8,0,0,0" Click="Join_Click"/>
                    <TextBox Name="AddressBox" Padding="4" KeyDown="AddressBox_KeyDown"/>
                </DockPanel>
                <TextBlock Text="IP хоста, например 26.12.34.56. Порт указывать не нужно." Foreground="Gray" FontSize="14" Margin="0,4,0,16"/>

                <DockPanel>
                    <Button Name="SearchButton" Content="Обновить" DockPanel.Dock="Right" Width="120" Click="Search_Click"/>
                    <TextBlock Text="Игры в сети" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox Name="GamesList" Height="120" Margin="0,4,0,0"
                         SelectionChanged="GamesList_SelectionChanged" MouseDoubleClick="GamesList_MouseDoubleClick"/>
                <TextBlock Name="SearchStatus" Foreground="Gray" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>

                <TextBlock Name="StatusText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,16,0,0"/>
                <TextBlock Name="VersionText" Foreground="Gray" FontSize="12" HorizontalAlignment="Right" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
