<UserControl x:Class="Monopoly.App.StartScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="17" Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource TableBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,24">
            <!-- Логотип игры (Assets\StartLogo.png — уменьшенная копия Assets\Icon\monopoly_logo.png). -->
            <Image Source="/Assets/StartLogo.png" Width="400" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Монополія"/>
            <TextBlock Text="для децелов (Максімка, Ілюшка, Данюшка, Ярушка і Чушка)" HorizontalAlignment="Center"
                       Style="{StaticResource Muted}" FontSize="13" FontStyle="Italic" Margin="0,2,0,24"/>

            <!-- Скачана новая версия (Updater): перезапуск сразу или само при выходе из игры. -->
            <Border Name="UpdateBanner" Width="620" Margin="0,0,0,14" Padding="20,14" CornerRadius="14" Visibility="Collapsed"
                    Background="#2A3A1F" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1">
                <DockPanel>
                    <Button Name="UpdateButton" DockPanel.Dock="Right" Content="Оновити" Style="{StaticResource PrimaryButton}"
                            Margin="14,0,0,0" MinWidth="130" Click="Update_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="UpdateTitle" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Name="UpdateHint" Style="{StaticResource Muted}" FontSize="14"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Width="620" Padding="28" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock Text="Ваше ім'я" Style="{StaticResource Muted}"/>
                    <TextBox Name="NameBox" MaxLength="20" FontSize="20" Margin="0,6,0,18"/>

                    <Button Name="CreateButton" Content="Створити гру" Style="{StaticResource PrimaryButton}" FontSize="20" MinHeight="52" Click="Create_Click"/>
                    <TextBlock Text="Ви станете хостом, друзі підключаться до вас." Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0"/>

                    <!-- Незаконченные партии, где этот компьютер был хостом. -->
                    <StackPanel Name="SavesSection" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock Text="Продовжити партію" FontWeight="Bold" FontSize="19"/>
                        <StackPanel Name="SavesPanel" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource SurfaceBorderBrush}" Margin="0,22"/>

                    <TextBlock Text="Підключитися до гри" FontWeight="Bold" FontSize="19"/>
                    <DockPanel Margin="0,10,0,0">
                        <Button Name="JoinButton" Content="Підключитися" DockPanel.Dock="Right" Margin="10,0,0,0" MinWidth="160" Click="Join_Click"/>
                        <TextBox Name="AddressBox" KeyDown="AddressBox_KeyDown"/>
                    </DockPanel>
                    <TextBlock Text="IP хоста, наприклад 26.12.34.56. Порт вказувати не треба." Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,18"/>

                    <DockPanel>
                        <Button Name="SearchButton" Content="⟳  Оновити" DockPanel.Dock="Right" FontSize="15" MinHeight="32" Padding="12,4" Click="Search_Click"/>
                        <TextBlock Text="Ігри в мережі" VerticalAlignment="Center" FontWeight="Bold"/>
                    </DockPanel>
                    <Border Background="#0F1C30" CornerRadius="10" Margin="0,8,0,0" Padding="4" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1">
                        <ListBox Name="GamesList" Height="120" Style="{StaticResource DarkList}"
                                 SelectionChanged="GamesList_SelectionChanged" MouseDoubleClick="GamesList_MouseDoubleClick"/>
                    </Border>
                    <TextBlock Name="SearchStatus" Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0"/>

                    <TextBlock Name="StatusText" Foreground="#FF8A8D" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Name="VersionText" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
