<UserControl x:Class="Monopoly.App.LobbyScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F4F1EA">
        <Border Width="1000" Padding="32" Margin="16" Background="White" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Игроки и готовность. -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Лобби" FontSize="36" FontWeight="Bold"/>
                    <TextBlock Name="SeatsTitle" Foreground="Gray" Margin="0,4,0,12"/>
                    <StackPanel Name="SeatsPanel"/>

                    <TextBlock Text="Цвет вашей фишки" Margin="0,20,0,4"/>
                    <WrapPanel Name="ColorsPanel"/>

                    <CheckBox Name="ReadyBox" Content="Я готов" Margin="0,20,0,0" VerticalContentAlignment="Center"
                              Checked="Ready_Changed" Unchecked="Ready_Changed"/>

                    <Button Name="StartButton" Content="Начать игру" Height="44" Margin="0,20,0,0" Click="Start_Click"/>
                    <TextBlock Name="StartHint" Foreground="Gray" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    <TextBlock Name="StatusText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Button Content="Выйти" Width="120" Height="36" HorizontalAlignment="Left" Margin="0,20,0,0" Click="Leave_Click"/>
                </StackPanel>

                <!-- Как подключиться: адреса хоста и брандмауэр. -->
                <StackPanel Grid.Column="2">
                    <TextBlock Name="ConnectionTitle" FontWeight="Bold" Margin="0,8,0,8"/>
                    <StackPanel Name="AddressesPanel"/>
                    <TextBlock Name="ConnectionHint" Foreground="Gray" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <StackPanel Name="FirewallPanel" Visibility="Collapsed" Margin="0,24,0,0">
                        <TextBlock Name="FirewallText" TextWrapping="Wrap" FontSize="14"/>
                        <Button Name="FirewallButton" Content="Разрешить в брандмауэре" Height="36" Margin="0,8,0,0" Click="Firewall_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
