<UserControl x:Class="Monopoly.App.LobbyScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="17" Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource TableBrush}">
        <Border Style="{StaticResource Card}" Width="1040" Padding="32" Margin="16,24"
                HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource SoftShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <!-- Игроки и готовность. -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Лобі" Style="{StaticResource Title}" FontSize="38"/>
                    <TextBlock Text="для децелов (Максімка, Ілюшка, Данюшка, Ярушка і Чушка)" Style="{StaticResource Muted}"
                               FontSize="13" FontStyle="Italic"/>
                    <TextBlock Name="SeatsTitle" Style="{StaticResource Muted}" Margin="0,2,0,14"/>
                    <StackPanel Name="SeatsPanel"/>
                    <Button Name="AddBotButton" Content="+  Додати бота" HorizontalAlignment="Left" FontSize="15" MinHeight="34" Padding="14,4"
                            Margin="0,8,0,0" Click="AddBot_Click"/>

                    <TextBlock Text="Колір вашої фішки" Style="{StaticResource Muted}" Margin="0,18,0,8"/>
                    <WrapPanel Name="ColorsPanel"/>

                    <CheckBox Name="ReadyBox" Content="Я готовий до гри" FontSize="19" Margin="0,20,0,0" VerticalContentAlignment="Center"
                              Checked="Ready_Changed" Unchecked="Ready_Changed"/>

                    <Button Name="StartButton" Content="Почати гру" Style="{StaticResource PrimaryButton}" FontSize="20" MinHeight="52" Margin="0,22,0,0" Click="Start_Click"/>
                    <TextBlock Name="StartHint" Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0"/>

                    <TextBlock Name="StatusText" Foreground="#FF8A8D" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <Button Content="Вийти" HorizontalAlignment="Left" Margin="0,18,0,0" MinWidth="120" Click="Leave_Click"/>
                </StackPanel>

                <!-- Как подключиться: адреса хоста и брандмауэр. -->
                <Border Grid.Column="2" Background="#15243B" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Name="ConnectionTitle" FontWeight="Bold" FontSize="20" Margin="0,0,0,10"/>
                        <StackPanel Name="AddressesPanel"/>
                        <TextBlock Name="ConnectionHint" Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0"/>

                        <StackPanel Name="FirewallPanel" Visibility="Collapsed" Margin="0,20,0,0">
                            <TextBlock Name="FirewallText" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                            <Button Name="FirewallButton" Content="Дозволити в брандмауері" Margin="0,10,0,0" Click="Firewall_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
