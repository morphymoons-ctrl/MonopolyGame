<UserControl x:Class="Monopoly.App.GameScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <!-- Прозрачная кнопка поверх клетки: щелчок мышью, клавиатура и UI Automation. -->
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hover" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#142F7BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource TableBrush}">
        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">

                <!-- Поле в рамке: шире, чем выше; крайние ряды глубокие, центр поменьше. -->
                <Border Margin="24,28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{StaticResource BoardFrameBrush}" CornerRadius="22" Padding="12" Effect="{StaticResource SoftShadow}">
                    <Grid Width="1300" Height="1000">
                        <!-- Центр поля: отступы = глубина крайних рядов (GameManager.ColumnDepth, RowDepth). -->
                        <Border Margin="190,150" Background="{StaticResource BoardCenterBrush}"/>
                        <Canvas Name="GameBoardCanvas" Width="1300" Height="1000"/>

                        <!-- Середина поля: логотип, кубики и карточка хода. -->
                        <StackPanel Margin="225,170,225,0" VerticalAlignment="Top">
                            <TextBlock Text="МОНОПОЛІЯ" FontSize="60" FontWeight="Black" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="3" BlurRadius="0" Color="#1A1C20" Opacity="1"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,26">
                                <ContentControl Name="Die1Host" Margin="0,0,20,0"/>
                                <ContentControl Name="Die2Host"/>
                            </StackPanel>
                            <Border Style="{StaticResource BoardCard}" Padding="24">
                                <StackPanel>
                                    <Border Name="ContextBar" Height="10" CornerRadius="5" Margin="0,0,0,14" Visibility="Collapsed"/>
                                    <DockPanel>
                                        <TextBlock Name="TimerText" DockPanel.Dock="Right" FontSize="24" FontWeight="Bold" Margin="12,4,0,0"
                                                   Foreground="{StaticResource BoardMutedBrush}"/>
                                        <TextBlock Name="ContextTitle" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BoardTextBrush}"/>
                                    </DockPanel>
                                    <TextBlock Name="ContextText" FontSize="19" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{StaticResource BoardMutedBrush}"/>
                                    <WrapPanel Name="ActionsPanel" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Длительность партии — внизу середины поля. -->
                        <TextBlock Name="DurationText" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,166"
                                   FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BoardMutedBrush}"/>

                        <Canvas Name="TokenCanvas" Width="1300" Height="1000" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Правая колонка: игроки, карточка компании, журнал, кнопки. -->
                <Grid Margin="1372,28,24,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Name="PlayersPanel" Grid.Row="0"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,4,0,12" Padding="16">
                        <StackPanel>
                            <Border Name="DeedHeader" CornerRadius="10" Padding="16,10" Background="#1F3354">
                                <TextBlock Name="CellTitle" FontSize="26" FontWeight="Bold" Foreground="White" Text="Картка клітинки"/>
                            </Border>
                            <TextBlock Name="CellInfo" FontSize="17" Margin="2,10,2,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Натисніть на клітинку поля — тут з'являться оренда й кнопки для вашої компанії."/>
                            <Grid Name="RentTable" Margin="2,8,2,0"/>
                            <WrapPanel Name="CellActions" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,10">
                        <ListBox Name="ActionLog" Style="{StaticResource DarkList}" FontSize="17"/>
                    </Border>

                    <!-- Узкая колонка: обмен и статистика, под ними звук и выход. -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="10"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Button Name="TradeButton" Content="⇄  Обмін" FontSize="17" Click="Trade_Click"/>
                        <Button Name="StatsButton" Grid.Column="2" Content="Статистика" FontSize="17" Click="Stats_Click"/>
                        <Button Name="SoundButton" Grid.Row="2" FontSize="17" Click="Sound_Click"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="Вийти в меню" FontSize="17" Click="Leave_Click"/>
                    </Grid>
                </Grid>

                <!-- Обмен — внутри игры, поверх поля (TradePanel). Щелчок по затемнению закрывает. -->
                <Border Name="TradeOverlay" Background="{StaticResource OverlayDimBrush}" Visibility="Collapsed"
                        MouseLeftButtonDown="TradeOverlay_MouseDown"/>
            </Grid>
        </Viewbox>

        <!-- Связь пропала: клиент сам переподключается. -->
        <Border Name="ReconnectOverlay" Background="#CC0A1424" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24"
                    Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock Text="Зв'язок із хостом зник" Style="{StaticResource Title}" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="Перепідключаємося… Місце в партії чекає на вас 2 хвилини." Style="{StaticResource Muted}"
                               FontSize="17" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
