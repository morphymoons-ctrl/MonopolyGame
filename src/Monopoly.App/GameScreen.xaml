<UserControl x:Class="Monopoly.App.GameScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Canvas Name="GameBoardCanvas" Width="1000" Height="1000" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <ListBox Name="ActionLog" Width="870" Height="1000" Margin="1040,10,10,10" HorizontalAlignment="Left" FontSize="24"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <!-- Середина поля: игроки и кнопки хода. -->
            <StackPanel Width="740" Margin="150,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Name="TurnText" Margin="10" FontSize="36" FontWeight="Bold"/>
                <StackPanel Name="PlayersPanel" Margin="10"/>
                <WrapPanel Margin="0,20,0,0">
                    <Button Name="RollDiceButton" Content="Бросить кубики" Width="220" Height="60" Margin="10" FontSize="24" Click="RollDice_Click"/>
                    <Button Name="BuyButton" Content="Купить" Width="220" Height="60" Margin="10" FontSize="24" Click="Buy_Click"/>
                    <Button Name="DeclineButton" Content="Не покупать" Width="220" Height="60" Margin="10" FontSize="24" Click="Decline_Click"/>
                    <Button Name="EndTurnButton" Content="Завершить ход" Width="220" Height="60" Margin="10" FontSize="24" Click="EndTurn_Click"/>
                </WrapPanel>
                <Button Content="Выйти в меню" Width="220" Height="50" Margin="10,40,10,10" FontSize="20" HorizontalAlignment="Left" Click="Leave_Click"/>
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
