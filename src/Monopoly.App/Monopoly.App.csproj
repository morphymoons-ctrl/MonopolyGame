<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF-клиент: поле, окна, лобби. Логика игры — в Monopoly.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Monopoly</AssemblyName>
    <RootNamespace>Monopoly.App</RootNamespace>
    <!-- Свой Main: сначала Velopack (установка и обновления), потом игра. -->
    <StartupObject>Monopoly.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monopoly.Core\Monopoly.Core.csproj" />
    <ProjectReference Include="..\Monopoly.Net\Monopoly.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Логотипы компаний на клетках (Logos.cs), по папке на доску: business, military. Вшиваются в Monopoly.exe. -->
    <Resource Include="Assets\Logos\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Установка и автообновление из GitHub Releases (этап 6, Updater.cs). Версия — та же, что у утилиты vpk. -->
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

</Project>
