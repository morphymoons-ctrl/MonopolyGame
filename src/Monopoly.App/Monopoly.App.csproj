<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF-клиент: поле, окна, лобби. Логика игры — в Monopoly.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Monopoly</AssemblyName>
    <RootNamespace>Monopoly.App</RootNamespace>
    <!-- Свой Main: сначала Velopack (установка и обновления), потом игра. -->
    <StartupObject>Monopoly.App.Program</StartupObject>
    <!-- Иконка exe: ярлыки, панель задач и заголовок окна берут её отсюда. Пока файла нет — стандартная. -->
    <ApplicationIcon Condition="Exists('Assets\Icon\monopoly.ico')">Assets\Icon\monopoly.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monopoly.Core\Monopoly.Core.csproj" />
    <ProjectReference Include="..\Monopoly.Net\Monopoly.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Картинки клеток (Logos.cs), по папке на доску: логотипы — PNG, фото — JPEG. Вшиваются в Monopoly.exe. -->
    <Resource Include="Assets\Logos\**\*.png" />
    <Resource Include="Assets\Logos\**\*.jpg" />
    <!-- Логотип на стартовом экране. -->
    <Resource Include="Assets\StartLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Установка и автообновление из GitHub Releases (этап 6, Updater.cs). Версия — та же, что у утилиты vpk. -->
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

</Project>
