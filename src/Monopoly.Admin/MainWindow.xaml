<Window x:Class="Monopoly.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Монополія — адміністратор" Width="1320" Height="860" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource TableBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Слева: партии в сети и подключение по адресу. -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Партії в мережі" Style="{StaticResource Title}" FontSize="22"/>
                    <TextBlock Name="SearchText" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" Text="Пошук…"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="Або адреса вручну:" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button Name="ConnectButton" DockPanel.Dock="Right" Content="Підключитися" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Margin="8,0,0,0" Click="OnConnectByAddress"/>
                        <TextBox Name="AddressBox" FontSize="15" KeyDown="OnAddressKeyDown"/>
                    </DockPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="GamesPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Справа: выбранная партия. -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button Name="DisconnectButton" DockPanel.Dock="Right" Content="Відключитися" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" VerticalAlignment="Top" Visibility="Collapsed" Click="OnDisconnect"/>
                    <StackPanel>
                        <TextBlock Name="GameTitle" Text="Панель адміністратора" Style="{StaticResource Title}" FontSize="26"/>
                        <TextBlock Name="GameSubtitle" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"
                                   Text="Оберіть партію зліва. Зміни тихі: гравці бачать лише нові числа."/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Name="StatusText" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Name="PlayersTitle" Text="Гравці" Style="{StaticResource Title}" FontSize="19" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <StackPanel Name="PlayersPanel"/>
                        <TextBlock Name="CompaniesTitle" Text="Компанії" Style="{StaticResource Title}" FontSize="19" Margin="0,18,0,8" Visibility="Collapsed"/>
                        <StackPanel Name="CompaniesPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
