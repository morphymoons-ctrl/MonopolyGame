<Window x:Class="Monopoly.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Монополія — встановлення" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource TableBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="16" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="28,24,28,28">
        <TextBlock Text="МОНОПОЛІЯ" FontSize="44" FontWeight="Black" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="3" BlurRadius="0" Color="#2F7BFF" Opacity="1"/>
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock Name="VersionText" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,20"/>

        <Border Style="{StaticResource Card}" Padding="22">
            <StackPanel>
                <TextBlock Text="Куди встановити гру" FontWeight="Bold" FontSize="19"/>
                <DockPanel Margin="0,10,0,0">
                    <Button Name="BrowseButton" DockPanel.Dock="Right" Content="Змінити…" Margin="10,0,0,0" MinWidth="130" Click="Browse_Click"/>
                    <TextBox Name="PathBox" FontSize="16"/>
                </DockPanel>
                <TextBlock Name="HintText" Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0"
                           Text="Ярлики з'являться на робочому столі та в меню «Пуск». Гра оновлюватиметься сама."/>
                <TextBlock Name="ErrorText" Foreground="#FF8A8D" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <DockPanel Margin="0,18,0,0">
            <Button Name="CancelButton" DockPanel.Dock="Right" Content="Скасувати" MinWidth="130" Margin="10,0,0,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Name="InstallButton" DockPanel.Dock="Right" Content="Встановити" Style="{StaticResource PrimaryButton}" MinWidth="170" IsDefault="True" Click="Install_Click"/>
            <TextBlock Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
    </StackPanel>
</Window>
