<Project>

  <!-- Shared settings for every project in the solution. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Game version; clients will compare it with the host's on connect. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
