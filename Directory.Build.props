<Project>

  <!-- Общие настройки для всех проектов решения. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Версия игры; при подключении клиент сверяет её с версией хоста. -->
    <Version>0.6.0</Version>
  </PropertyGroup>

</Project>
