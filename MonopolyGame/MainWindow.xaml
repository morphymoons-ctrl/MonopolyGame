<Window x:Class="MonopolyGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Монополия"
        Width="1920" Height="1080"
        MinWidth="1280" MinHeight="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Canvas Name="GameBoardCanvas" Width="1400" Height="1000" Margin="10"/>
            <ListBox Name="ActionLog" Width="450" Height="1000" Margin="1420,10,10,10" HorizontalAlignment="Right" FontSize="24"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,10,20">
                <Button Content="Бросить кубики" Width="180" Height="60" Margin="10" FontSize="24" Click="RollDice_Click"/>
                <Button Content="Купить" Width="180" Height="60" Margin="10" FontSize="24" Click="Buy_Click"/>
                <Button Content="Передать ход" Width="180" Height="60" Margin="10" FontSize="24" Click="EndTurn_Click"/>
                <Button Content="Заплатить залог" Width="180" Height="60" Margin="10" FontSize="24" Click="PayBail_Click"/>
                <Button Content="Казино" Width="180" Height="60" Margin="10" FontSize="24" Click="Casino_Click"/>
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>
